<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Retrait - Groupe Dangote (GD)</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        * { margin:0; padding:0; box-sizing:border-box; font-family:'Poppins','Segoe UI',sans-serif; }
        body { background:#F5EFE6; color:#3D2B1F; min-height:100vh; padding-bottom:90px; }
        .container { max-width:430px; margin:0 auto; }

        .page-header {
            background: linear-gradient(135deg, #D4921F, #A0631A);
            padding: 50px 20px 28px; display:flex; align-items:center; gap:14px;
        }
        .back-btn {
            width:36px; height:36px; border-radius:50%;
            background:rgba(255,255,255,0.2); display:flex; align-items:center;
            justify-content:center; color:#fff; text-decoration:none; font-size:16px; flex-shrink:0;
        }
        .header-txt h1 { font-size:20px; font-weight:700; color:#fff; }
        .header-txt p  { font-size:13px; color:rgba(255,255,255,0.85); margin-top:2px; }

        .content { padding:16px; }

        .balance-hero {
            background: linear-gradient(135deg, #D4921F, #B07018);
            border-radius:18px; padding:22px; text-align:center;
            margin-bottom:16px; box-shadow:0 6px 20px rgba(196,125,30,0.35);
        }
        .balance-hero .lbl { color:rgba(255,255,255,0.8); font-size:12px; font-weight:600;
            text-transform:uppercase; letter-spacing:1px; margin-bottom:8px; }
        .balance-hero .amt { color:#fff; font-size:36px; font-weight:800; line-height:1; }
        .balance-hero .cur { color:rgba(255,255,255,0.8); font-size:14px; margin-top:6px; }

        .notif { padding:12px 15px; border-radius:12px; margin-bottom:14px;
            font-size:14px; display:flex; align-items:center; gap:9px; }
        .notif.error   { background:#FFF0EE; border:1px solid #F5A9A0; color:#C0392B; }
        .notif.success { background:#F0FFF4; border:1px solid #86EFAC; color:#166534; }

        .warning-card {
            background:#FFFBF0; border:1px solid #F5D78A; border-radius:12px;
            padding:13px 15px; margin-bottom:14px; font-size:13px; color:#92660A;
            display:flex; align-items:center; gap:9px;
        }
        .info-card {
            background:rgba(196,125,30,0.08); border:1px solid rgba(196,125,30,0.2);
            border-radius:12px; padding:13px 15px; margin-bottom:14px;
            font-size:13px; color:#7D5A38;
        }
        .info-card strong { color:#C47D1E; }

        .form-card {
            background:#fff; border-radius:16px; border:1px solid #F0E0C8;
            padding:18px; margin-bottom:14px; box-shadow:0 2px 10px rgba(196,125,30,0.08);
        }
        .form-card h3 { color:#C47D1E; font-size:14px; font-weight:700; margin-bottom:16px;
            display:flex; align-items:center; gap:8px; }
        .form-group { margin-bottom:14px; }
        .form-label { display:block; font-size:12px; font-weight:600; color:#A87D50; margin-bottom:6px; }
        .form-input, .form-select {
            width:100%; background:#FBF5EC; border:1.5px solid #E8D5B0;
            border-radius:11px; padding:12px 14px; color:#3D2B1F;
            font-size:14px; font-family:'Poppins',sans-serif; outline:none;
            transition:border-color 0.2s; appearance:none; -webkit-appearance:none;
        }
        .form-input:focus, .form-select:focus { border-color:#C47D1E; }
        .select-wrap { position:relative; }
        .select-wrap::after {
            content:'\f107'; font-family:'Font Awesome 6 Free'; font-weight:900;
            position:absolute; right:14px; top:50%; transform:translateY(-50%);
            color:#C47D1E; pointer-events:none;
        }
        .country-picker { position:relative; }
        .country-trigger {
            width:100%; min-height:46px; display:flex; align-items:center;
            justify-content:space-between; gap:10px; padding:11px 13px;
            background:#FBF5EC; border:1.5px solid #E8D5B0; border-radius:11px;
            color:#3D2B1F; font-size:14px; font-family:'Poppins',sans-serif;
            cursor:pointer; text-align:left;
        }
        .country-trigger:hover, .country-picker.open .country-trigger {
            border-color:#C47D1E; box-shadow:0 0 0 3px rgba(196,125,30,0.12);
        }
        .country-trigger i { color:#C47D1E; font-size:13px; transition:transform 0.2s; }
        .country-picker.open .country-trigger i { transform:rotate(180deg); }
        .country-menu {
            display:none; position:absolute; z-index:30; top:calc(100% + 6px);
            left:0; right:0; padding:7px; background:#fff; border:1px solid #E8D5B0;
            border-radius:12px; box-shadow:0 10px 24px rgba(61,43,31,0.16);
        }
        .country-picker.open .country-menu { display:block; }
        .country-search-wrap { position:relative; margin-bottom:7px; }
        .country-search-wrap i {
            position:absolute; left:13px; top:50%; transform:translateY(-50%);
            color:#B09070; font-size:13px; pointer-events:none;
        }
        .country-search {
            width:100%; height:42px; background:#FBF5EC; border:1.5px solid #E8D5B0;
            border-radius:10px; padding:10px 12px 10px 36px; color:#3D2B1F;
            font-size:13px; font-family:'Poppins',sans-serif; outline:none;
        }
        .country-search:focus {
            border-color:#C47D1E; box-shadow:0 0 0 3px rgba(196,125,30,0.12);
        }
        .country-options {
            max-height:224px; overflow-y:auto; padding:0; background:#FBF5EC;
            border:1px solid #E8D5B0; border-radius:10px;
            scrollbar-width:thin; scrollbar-color:#D5B27B transparent;
        }
        .country-option {
            width:100%; min-height:41px; display:flex; align-items:center;
            justify-content:space-between; gap:10px; padding:9px 11px;
            background:transparent; border:0; border-radius:8px; color:#3D2B1F;
            text-align:left; font-size:13px; font-family:'Poppins',sans-serif;
            cursor:pointer; transition:background 0.15s, color 0.15s;
        }
        .country-option + .country-option { margin-top:2px; }
        .country-option:hover { background:#FEF3DA; }
        .country-option.active { background:#C47D1E; color:#fff; font-weight:700; }
        .country-option-code { font-size:11px; opacity:0.7; font-weight:600; }
        .country-option.active .country-option-code { opacity:0.9; }
        .country-empty {
            padding:12px; color:#A87D50; font-size:12px; text-align:center;
        }

        .phone-row { display:flex; gap:8px; }
        .phone-row .indicatif-box {
            flex-shrink:0; background:#FBF5EC; border:1.5px solid #E8D5B0;
            border-radius:11px; padding:12px 14px; color:#3D2B1F; font-size:14px;
            font-weight:600; min-width:90px; text-align:center;
        }
        .phone-row .form-input { flex:1; }

        .btn-submit {
            width:100%; background:linear-gradient(135deg,#D4921F,#B07018);
            color:#fff; border:none; border-radius:12px; padding:15px;
            font-weight:700; font-size:15px; cursor:pointer; font-family:'Poppins',sans-serif;
            box-shadow:0 4px 14px rgba(196,125,30,0.35); transition:transform 0.2s, opacity 0.2s;
        }
        .btn-submit:hover { transform:translateY(-2px); }
        .btn-submit:disabled { opacity:0.6; transform:none; }

        /* Success popup */
        .popup-overlay {
            display:none; position:fixed; inset:0;
            background:rgba(0,0,0,0.5); z-index:1000;
            align-items:center; justify-content:center; padding:20px;
        }
        .popup-overlay.show { display:flex; }
        .popup-box {
            background:#fff; border-radius:20px; padding:32px 24px;
            text-align:center; width:100%; max-width:340px;
            box-shadow:0 20px 60px rgba(0,0,0,0.25);
            animation: popIn 0.3s cubic-bezier(0.34,1.56,0.64,1);
        }
        @keyframes popIn {
            from { opacity:0; transform:scale(0.8); }
            to   { opacity:1; transform:scale(1); }
        }
        .popup-icon {
            width:72px; height:72px; background:#D4921F; border-radius:50%;
            display:flex; align-items:center; justify-content:center;
            margin:0 auto 18px;
        }
        .popup-icon svg { width:36px; height:36px; }
        .popup-title { color:#D4921F; font-size:1.2rem; font-weight:800; margin-bottom:8px; }
        .popup-msg { color:#666; font-size:0.9rem; margin-bottom:22px; line-height:1.5; }
        .popup-detail {
            background:#FBF5EC; border-radius:12px; padding:14px;
            margin-bottom:20px; font-size:0.9rem;
        }
        .popup-detail .row { display:flex; justify-content:space-between; padding:4px 0; }
        .popup-detail .key { color:#A87D50; }
        .popup-detail .val { font-weight:700; color:#3D2B1F; }
        .popup-ok {
            width:100%; background:linear-gradient(135deg,#D4921F,#B07018);
            color:#fff; border:none; border-radius:12px; padding:14px;
            font-weight:700; font-size:15px; cursor:pointer;
        }
    </style>
    <link rel="stylesheet" href="/assets/dangote-theme.css">
</head>
<body>
<%- include('partials/menu', { page: 'compte' }) %>
<div class="container">
    <div class="page-header">
        <a href="/" class="back-btn"><i class="fas fa-chevron-left"></i></a>
        <div class="header-txt">
            <h1>Retrait</h1>
            <p>Retirez votre argent en toute sécurité</p>
        </div>
    </div>

    <div class="content">
        <div class="balance-hero">
            <div class="lbl">Solde disponible</div>
            <div class="amt" data-currency-amount="<%= Number(solde || 0) %>"><%= Number(solde || 0).toLocaleString('fr-FR') %></div>
            <div class="cur" data-currency-code>FCFA</div>
        </div>

        <div id="notif-zone"></div>

        <% if (locals.retrait_bloque) { %>
        <div style="background:#FFF0EE;border:1.5px solid #F5A9A0;border-radius:14px;padding:18px 16px;margin-bottom:14px;text-align:center;">
            <div style="font-size:2rem;margin-bottom:8px;">🔒</div>
            <div style="font-size:15px;font-weight:700;color:#C0392B;margin-bottom:8px;">Retrait bloqué</div>
            <div style="font-size:13px;color:#7D2B1F;line-height:1.6;margin-bottom:16px;">
                Pour débloquer votre retrait, vous devez :<br>
                <strong>acheter un nouveau plan VIP</strong> ou <strong>inviter une personne à investir</strong>.
            </div>
            <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
                <a href="/investissement" style="display:inline-flex;align-items:center;gap:7px;background:linear-gradient(135deg,#D4921F,#B07018);color:#fff;text-decoration:none;border-radius:10px;padding:10px 18px;font-size:13px;font-weight:700;box-shadow:0 3px 10px rgba(196,125,30,0.35);">
                    <i class="fas fa-star"></i> Acheter un plan VIP
                </a>
                <a href="/equipe" style="display:inline-flex;align-items:center;gap:7px;background:#fff;color:#C47D1E;border:1.5px solid #D4921F;text-decoration:none;border-radius:10px;padding:10px 18px;font-size:13px;font-weight:700;">
                    <i class="fas fa-user-plus"></i> Inviter quelqu'un
                </a>
            </div>
        </div>
        <% } else if (locals.suspendu) { %>
        <div class="warning-card" style="background:#FFF0EE;border-color:#F5A9A0;color:#C0392B;">
            <i class="fas fa-ban"></i>
            <span>Le retrait est <strong>indisponible pour le moment</strong>, veuillez réessayer plus tard.</span>
        </div>
        <% } else if (locals.hasActiveInvestment === false) { %>
        <div class="warning-card">
            <i class="fas fa-circle-info"></i>
            <span>Vous devez acheter au moins une action avant de pouvoir effectuer un retrait.</span>
        </div>
        <% } %>

        <div class="form-card">
            <h3><i class="fas fa-arrow-up"></i> Informations de retrait</h3>

            <!-- Pays -->
            <div class="form-group">
                <label class="form-label">Pays</label>
                <div class="country-picker" id="countryPicker">
                    <button type="button" class="country-trigger" id="countryTrigger"
                            aria-haspopup="listbox" aria-expanded="false">
                        <span id="countrySelectedLabel">Cameroun</span>
                        <i class="fas fa-chevron-down" aria-hidden="true"></i>
                    </button>
                    <div class="country-menu" id="countryMenu">
                        <div class="country-search-wrap">
                            <i class="fas fa-search"></i>
                            <input type="search" id="countrySearch" class="country-search"
                                   placeholder="Rechercher un pays" autocomplete="off"
                                   aria-label="Rechercher un pays">
                        </div>
                        <div class="country-options" id="countryOptions" role="listbox" aria-label="Pays disponibles">
                            <button type="button" class="country-option" data-name="Cameroun" data-code="+237" role="option" aria-selected="false">
                                <span>Cameroun</span><span class="country-option-code">+237</span>
                            </button>
                            <button type="button" class="country-option" data-name="Togo" data-code="+228" role="option" aria-selected="false">
                                <span>Togo</span><span class="country-option-code">+228</span>
                            </button>
                            <button type="button" class="country-option" data-name="Bénin" data-code="+229" role="option" aria-selected="false">
                                <span>Bénin</span><span class="country-option-code">+229</span>
                            </button>
                            <button type="button" class="country-option" data-name="Côte d'Ivoire" data-code="+225" role="option" aria-selected="false">
                                <span>Côte d'Ivoire</span><span class="country-option-code">+225</span>
                            </button>
                            <button type="button" class="country-option" data-name="Burkina Faso" data-code="+226" role="option" aria-selected="false">
                                <span>Burkina Faso</span><span class="country-option-code">+226</span>
                            </button>
                            <button type="button" class="country-option" data-name="Gabon" data-code="+241" role="option" aria-selected="false">
                                <span>Gabon</span><span class="country-option-code">+241</span>
                            </button>
                            <button type="button" class="country-option" data-name="Congo Brazzaville" data-code="+242" role="option" aria-selected="false">
                                <span>Congo Brazzaville</span><span class="country-option-code">+242</span>
                            </button>
                            <button type="button" class="country-option" data-name="Niger" data-code="+227" role="option" aria-selected="false">
                                <span>Niger</span><span class="country-option-code">+227</span>
                            </button>
                            <button type="button" class="country-option" data-name="Mali" data-code="+223" role="option" aria-selected="false">
                                <span>Mali</span><span class="country-option-code">+223</span>
                            </button>
                            <div class="country-empty" id="countryEmpty" hidden>Aucun pays trouvé.</div>
                        </div>
                    </div>
                </div>
                <input type="hidden" id="sel-pays">
            </div>

            <!-- Opérateur -->
            <div class="form-group">
                <label class="form-label">Opérateur Mobile Money</label>
                <div class="select-wrap">
                    <select id="sel-operateur" class="form-select" required>
                        <option value="">-- Choisissez d'abord le pays --</option>
                    </select>
                </div>
            </div>

            <!-- Numéro -->
            <div class="form-group">
                <label class="form-label">Numéro Mobile Money</label>
                <div class="phone-row">
                    <div class="indicatif-box" id="indicatif-display">+237</div>
                    <input type="tel" id="inp-numero" class="form-input"
                           placeholder="Ex: 6XXXXXXXX" inputmode="numeric"
                           value="<%= (user.telephone || '').replace(/^\+\d+/, '') %>">
                </div>
            </div>

            <!-- Nom -->
            <div class="form-group">
                <label class="form-label">Nom complet du titulaire</label>
                <input type="text" id="inp-nom" class="form-input"
                       placeholder="Nom sur le compte Mobile Money"
                       value="<%= user.nom || '' %>">
            </div>

            <!-- Montant -->
            <div class="form-group">
                <label class="form-label">Montant à retirer (FCFA)</label>
                <input type="number" id="inp-montant" class="form-input"
                       min="<%= parseInt(locals.params && params.retrait_minimum ? params.retrait_minimum : 1200) %>" max="<%= solde %>" step="100"
                       placeholder="Minimum <%= parseInt(locals.params && params.retrait_minimum ? params.retrait_minimum : 1200).toLocaleString('fr-FR') %> FCFA" inputmode="numeric">
            </div>

            <% if (locals.fraisPourcentage > 0) { %>
            <div class="info-card" id="fee-summary" style="display:none;">
                <div style="display:flex;justify-content:space-between;margin-bottom:4px;">
                    <span>Montant demandé</span><strong id="fee-montant">—</strong>
                </div>
                <div style="display:flex;justify-content:space-between;margin-bottom:4px;color:#C0392B;">
                    <span>Frais de retrait (<span id="fee-pct"><%= fraisPourcentage %></span>%)</span><strong id="fee-frais">—</strong>
                </div>
                <div style="display:flex;justify-content:space-between;border-top:1px dashed #E8931A;padding-top:6px;">
                    <span>Vous recevrez</span><strong id="fee-net">—</strong>
                </div>
            </div>
            <% } %>

            <button class="btn-submit" id="btn-retrait">
                <i class="fas fa-paper-plane"></i> Demander le retrait
            </button>
        </div>
    </div>
</div>

<!-- Withdrawal rules popup -->
<div class="popup-overlay" id="withdrawInfoPopup">
    <div class="popup-box">
        <div class="popup-icon"><i class="fas fa-info"></i></div>
        <div class="popup-title" id="withdrawInfoTitle">Retrait indisponible</div>
        <div class="popup-msg" id="withdrawInfoMessage"></div>
        <button class="popup-ok" type="button" onclick="closeWithdrawInfo()">Compris</button>
    </div>
</div>

<!-- Success popup -->
<div class="popup-overlay" id="successPopup">
    <div class="popup-box">
        <div class="popup-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
            </svg>
        </div>
        <div class="popup-title">Retrait envoyé avec succès !</div>
        <div class="popup-msg">Votre demande a été soumise. Elle sera traitée dans les 24h.</div>
        <div class="popup-detail">
            <div class="row"><span class="key">Montant</span><span class="val" id="pop-montant">—</span></div>
            <div class="row"><span class="key">Opérateur</span><span class="val" id="pop-operateur">—</span></div>
            <div class="row"><span class="key">Numéro</span><span class="val" id="pop-numero">—</span></div>
            <div class="row"><span class="key">Nom</span><span class="val" id="pop-nom">—</span></div>
        </div>
        <button class="popup-ok" onclick="window.location.href='/'">OK</button>
    </div>
</div>

<script>
const operateursByPays = {
    'Cameroun':          ['MTN Mobile Money', 'Orange Money'],
    'Togo':              ['Flooz (Moov)', 'T-Money'],
    'Bénin':             ['MTN Mobile Money', 'Moov Money'],
    "Côte d'Ivoire":     ['Orange Money', 'MTN Mobile Money', 'Moov Money', 'Wave'],
    'Burkina Faso':      ['Orange Money', 'Moov Money'],
    'Gabon':             ['Airtel Money', 'Moov Money'],
    'Congo Brazzaville': ['Airtel Money', 'MTN Mobile Money'],
    'Niger':             ['Airtel Money'],
    'Mali':              ['Moov Money', 'Orange Money'],
};

const fraisPourcentage = <%= locals.fraisPourcentage || 0 %>;
const retraitDisponible = <%= locals.retraits_disponibles ? 'true' : 'false' %>;
const hasActiveInvestment = <%= locals.hasActiveInvestment ? 'true' : 'false' %>;
const retraitBloque = <%= locals.retrait_bloque ? 'true' : 'false' %>;
const retraitSuspendu = <%= locals.suspendu ? 'true' : 'false' %>;
const retraitMinimum = <%= parseFloat(locals.params && params.retrait_minimum ? params.retrait_minimum : 1200) %>;
const scheduleMessage = <%- JSON.stringify(locals.schedule && schedule.message ? schedule.message : 'Les retraits ne sont pas disponibles en ce moment.') %>;
const feeSummary   = document.getElementById('fee-summary');
const inpMontant   = document.getElementById('inp-montant');
function translateDynamic(value) {
    return window.GDLanguage ? window.GDLanguage.translate(value) : value;
}

function updateFeeSummary() {
    if (!feeSummary) return;
    const montant = parseFloat(inpMontant.value);
    if (!montant || montant <= 0) {
        feeSummary.style.display = 'none';
        return;
    }
    const frais = Math.round((montant * fraisPourcentage / 100) * 100) / 100;
    const net = montant - frais;
    document.getElementById('fee-montant').textContent = montant.toLocaleString('fr-FR') + ' FCFA';
    document.getElementById('fee-frais').textContent = '- ' + frais.toLocaleString('fr-FR') + ' FCFA';
    document.getElementById('fee-net').textContent = net.toLocaleString('fr-FR') + ' FCFA';
    feeSummary.style.display = 'block';
}
if (inpMontant) inpMontant.addEventListener('input', updateFeeSummary);

const selPays       = document.getElementById('sel-pays');
const selOp         = document.getElementById('sel-operateur');
const indicatifBox  = document.getElementById('indicatif-display');
const countrySearch = document.getElementById('countrySearch');
const countryEmpty  = document.getElementById('countryEmpty');
const countryOptions= Array.from(document.querySelectorAll('.country-option'));
const countryPicker = document.getElementById('countryPicker');
const countryTrigger= document.getElementById('countryTrigger');
const countryLabel  = document.getElementById('countrySelectedLabel');

function updateOperateurs() {
    const pays = selPays.value;
    const ops  = operateursByPays[pays] || [];
    const code = selPays.dataset.code || '';
    indicatifBox.textContent = code || '+???';
    selOp.innerHTML = ops.length
        ? ops.map(o => `<option value="${o}">${o}</option>`).join('')
        : '<option value="">-- ' + translateDynamic("Sélectionnez d'abord un pays") + ' --</option>';
}

function selectCountry(option) {
    countryOptions.forEach(item => {
        const selected = item === option;
        item.classList.toggle('active', selected);
        item.setAttribute('aria-selected', selected ? 'true' : 'false');
    });
    selPays.value = option.dataset.name;
    selPays.dataset.code = option.dataset.code;
    countryLabel.textContent = translateDynamic(option.dataset.name);
    updateOperateurs();
    toggleCountryMenu(false);
}

function toggleCountryMenu(open) {
    countryPicker.classList.toggle('open', open);
    countryTrigger.setAttribute('aria-expanded', open ? 'true' : 'false');
}

countryTrigger.addEventListener('click', () => {
    toggleCountryMenu(!countryPicker.classList.contains('open'));
});
countryOptions.forEach(option => {
    option.addEventListener('click', () => selectCountry(option));
});

countrySearch.addEventListener('input', function () {
    const query = this.value.trim().toLocaleLowerCase('fr-FR');
    let visibleCount = 0;
    countryOptions.forEach(option => {
        const matches = !query
            || option.dataset.name.toLocaleLowerCase('fr-FR').includes(query)
            || option.dataset.code.toLocaleLowerCase('fr-FR').includes(query);
        option.hidden = !matches;
        if (matches) visibleCount += 1;
    });
    countryEmpty.hidden = visibleCount !== 0;
});

// Select the first supported country by default.
if (countryOptions.length) selectCountry(countryOptions[0]);

document.addEventListener('click', event => {
    if (!countryPicker.contains(event.target)) toggleCountryMenu(false);
});
document.addEventListener('keydown', event => {
    if (event.key === 'Escape') toggleCountryMenu(false);
});

function showWithdrawInfo(title, message) {
    document.getElementById('withdrawInfoTitle').textContent = translateDynamic(title);
    document.getElementById('withdrawInfoMessage').textContent = translateDynamic(message);
    document.getElementById('withdrawInfoPopup').classList.add('show');
}

function closeWithdrawInfo() {
    document.getElementById('withdrawInfoPopup').classList.remove('show');
}

document.getElementById('withdrawInfoPopup').addEventListener('click', function (event) {
    if (event.target === this) closeWithdrawInfo();
});

document.getElementById('btn-retrait').addEventListener('click', async function () {
    const pays     = selPays.value;
    const operateur= selOp.value;
    const numero   = document.getElementById('inp-numero').value.trim();
    const nom      = document.getElementById('inp-nom').value.trim();
    const montant  = parseFloat(document.getElementById('inp-montant').value);
    const indicatif= selPays.dataset.code || '';
    const notifZone= document.getElementById('notif-zone');

    notifZone.innerHTML = '';

    if (!retraitDisponible) {
        const unavailableMessage = !hasActiveInvestment
            ? "Vous devez acheter au moins une action avant de pouvoir effectuer un retrait."
            : retraitBloque
                ? "Votre retrait est bloqué. Achetez un nouveau plan VIP ou invitez une personne à investir."
                : retraitSuspendu
                    ? 'Le retrait est indisponible pour le moment, veuillez réessayer plus tard.'
                    : scheduleMessage;
        showWithdrawInfo('Retrait indisponible', unavailableMessage);
        return;
    }

    if (!pays || !operateur || !numero || !nom || !montant) {
        notifZone.innerHTML = '<div class="notif error"><i class="fas fa-exclamation-circle"></i> ' + translateDynamic('Veuillez remplir tous les champs.') + '</div>';
        notifZone.scrollIntoView({ behavior: 'smooth' });
        return;
    }

    if (montant < retraitMinimum) {
        showWithdrawInfo(
            'Montant minimum non atteint',
            `${translateDynamic('Le montant minimum de retrait est de')} ${retraitMinimum.toLocaleString('fr-FR')} FCFA.`
        );
        return;
    }

    this.disabled = true;
    this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> ' + translateDynamic('Traitement...');

    try {
        const resp = await fetch('/retrait', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ pays, operateur, numero: indicatif + numero, nom, montant }),
        });

        // If redirected to login page, session expired
        if (resp.redirected || resp.url.includes('/connexion')) {
            window.location.href = '/connexion';
            return;
        }

        const text = await resp.text();
        let data;
        try { data = JSON.parse(text); }
        catch(e) {
            // Server returned HTML (session expired or server error)
            window.location.href = '/connexion';
            return;
        }

        if (data.success) {
            const netLabel = (typeof data.frais === 'number' && data.frais > 0)
                ? `${parseInt(montant).toLocaleString('fr-FR')} FCFA (frais ${data.frais.toLocaleString('fr-FR')} FCFA, net ${data.montantNet.toLocaleString('fr-FR')} FCFA)`
                : parseInt(montant).toLocaleString('fr-FR') + ' FCFA';
            document.getElementById('pop-montant').textContent   = netLabel;
            document.getElementById('pop-operateur').textContent = operateur;
            document.getElementById('pop-numero').textContent    = indicatif + numero;
            document.getElementById('pop-nom').textContent       = nom;
            document.getElementById('successPopup').classList.add('show');
        } else {
            const message = String(data.message || '');
            if (/disponible|minimum de retrait/i.test(message)) {
                showWithdrawInfo(
                    /minimum de retrait/i.test(message) ? 'Montant minimum non atteint' : 'Retrait indisponible',
                    message
                );
            } else {
                notifZone.innerHTML = `<div class="notif error"><i class="fas fa-exclamation-circle"></i> ${translateDynamic(message)}</div>`;
                notifZone.scrollIntoView({ behavior: 'smooth' });
            }
            this.disabled = false;
            this.innerHTML = '<i class="fas fa-paper-plane"></i> ' + translateDynamic('Demander le retrait');
        }
    } catch (e) {
        notifZone.innerHTML = '<div class="notif error"><i class="fas fa-exclamation-circle"></i> ' + translateDynamic('Erreur de connexion.') + '</div>';
        this.disabled = false;
        this.innerHTML = '<i class="fas fa-paper-plane"></i> ' + translateDynamic('Demander le retrait');
    }
});
</script>
</body>
</html>
