<div class="pwa-install-banner" data-pwa-install-banner role="region" aria-live="polite" hidden>
    <img class="pwa-install-icon" src="/images/pwa-icon-192.png" alt="" width="44" height="44">
    <div class="pwa-install-copy">
        <strong>Téléchargez notre application</strong>
        <small>Accès rapide depuis votre écran d’accueil</small>
    </div>
    <button class="pwa-install-action" type="button" data-pwa-install-button>Installer</button>
    <button class="pwa-install-close" type="button" data-pwa-install-close aria-label="Fermer">×</button>
    <span class="pwa-install-progress" aria-hidden="true"></span>
</div>

<div class="pwa-install-help" data-pwa-install-help role="dialog" aria-modal="true"
     aria-labelledby="pwa-install-help-title" hidden>
    <div class="pwa-install-help-card">
        <button class="pwa-install-help-close" type="button" data-pwa-install-help-close
                aria-label="Fermer">×</button>
        <h2 id="pwa-install-help-title">Installer l’application</h2>
        <p data-pwa-install-steps></p>
    </div>
</div>