<script>
    (function () {
        var supported = ['fr', 'en', 'es', 'zh', 'ur'];
        var stored = null;
        try { stored = window.localStorage.getItem('gd_language'); } catch (error) {}
        var language = supported.indexOf(stored) >= 0 ? stored : 'fr';
        document.documentElement.lang = language;
        document.documentElement.dir = language === 'ur' ? 'rtl' : 'ltr';
        document.documentElement.classList.add('gd-language-pending');
        window.setTimeout(function () {
            document.documentElement.classList.remove('gd-language-pending');
        }, 2500);
    })();
</script>
<style>
    html.gd-language-pending body { visibility: hidden; }
</style>
<div class="gd-language-picker" data-language-picker>
    <button type="button" class="gd-language-toggle" data-language-toggle aria-label="Choisir la langue" aria-expanded="false">
        <span class="gd-language-globe" aria-hidden="true">🌐</span>
        <span data-language-current>FR</span>
        <span class="gd-language-chevron" aria-hidden="true">▾</span>
    </button>
    <div class="gd-language-menu" data-language-menu role="menu">
        <button type="button" data-language-option="fr" role="menuitem"><span>🇫🇷</span> Français</button>
        <button type="button" data-language-option="en" role="menuitem"><span>🇬🇧</span> English</button>
        <button type="button" data-language-option="es" role="menuitem"><span>🇪🇸</span> Español</button>
        <button type="button" data-language-option="zh" role="menuitem"><span>🇨🇳</span> 中文</button>
        <button type="button" data-language-option="ur" role="menuitem"><span>🇵🇰</span> اردو</button>
    </div>
</div>
<style>
