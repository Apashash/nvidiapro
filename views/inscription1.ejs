<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Inscription - Groupe Dangote (GD)</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
        html {
            scroll-behavior: smooth;
            -webkit-text-size-adjust: 100%;
        }
        html, body { min-height:100vh; overflow-x:hidden; font-family:'Poppins',sans-serif; }
        body {
            background:#F5EFE6;
            display:flex;
            flex-direction:column;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
        }
        .hero {
            height: 230px;
            background: linear-gradient(to bottom, rgba(10,5,0,0.30), rgba(10,5,0,0.55)),
                        url('/images/slide1.jpeg') center/cover no-repeat;
            display: flex; flex-direction:column; align-items:center; justify-content:center;
        }
        .hero-logo {
            width:80px; height:80px; border-radius:50%;
            overflow:hidden;
            box-shadow: 0 0 0 3px rgba(212,146,31,0.6), 0 8px 24px rgba(0,0,0,0.5);
            margin-bottom:10px;
        }
        .hero-logo img { width:100%; height:100%; object-fit:cover; }
        .hero h1 { font-size:24px; font-weight:800; color:#fff; text-shadow:0 2px 8px rgba(0,0,0,0.6); }
        .hero p { font-size:12px; color:rgba(255,255,255,0.9); margin-top:3px; }
        .form-card {
            background:#fff; border-radius:28px 28px 0 0; margin-top:-28px;
            flex-shrink:0; padding:28px 24px calc(40px + env(safe-area-inset-bottom, 0px));
            box-shadow: 0 -8px 32px rgba(196,125,30,0.10);
        }
        .referral-notice {
            background: #FBF5EC; border:1px solid #E8D5B0; border-radius:12px;
            padding:11px 14px; margin-bottom:16px; display:flex; align-items:center;
            gap:9px; color:#7D5A38; font-size:13px;
        }
        .referral-notice i { color:#C47D1E; }
        .form-title { font-size:20px; font-weight:700; color:#3D2B1F; margin-bottom:20px; }
        .form-group { margin-bottom:16px; }
        .form-label { display:block; font-size:13px; font-weight:600; color:#7D5A38; margin-bottom:7px; }
        .input-wrap {
            display:flex; align-items:center;
            background:#FBF5EC; border:1.5px solid #E8D5B0; border-radius:14px;
            overflow:hidden; transition:border-color 0.2s, box-shadow 0.2s;
            position:relative;
        }
        .input-wrap input[type="password"],
        .input-wrap input[type="text"] { padding-right:48px !important; }
        .input-wrap:focus-within { border-color:#C47D1E; box-shadow:0 0 0 3px rgba(196,125,30,0.15); }
        .input-icon {
            width:46px; height:50px;
            background:linear-gradient(135deg,#D4921F,#B07018);
            display:flex; align-items:center; justify-content:center;
            flex-shrink:0; border-radius:11px; margin:4px;
        }
        .input-icon i { color:#fff; font-size:15px; }
        .input-wrap input, .input-wrap select {
            flex:1; border:none; background:transparent;
            padding:13px 13px 13px 10px; font-size:14px; color:#3D2B1F;
            font-family:'Poppins',sans-serif; outline:none;
        }
        .input-wrap select { cursor:pointer; -webkit-appearance:none; max-width:95px; }
        .phone-divider { width:1px; height:22px; background:#E8D5B0; flex-shrink:0; }
        .country-picker { position:relative; margin-bottom:8px; }
        .country-trigger {
            width:100%; min-height:52px; display:flex; align-items:center;
            justify-content:space-between; gap:10px; padding:11px 13px;
            background:#FBF5EC; border:1.5px solid #E8D5B0; border-radius:14px;
            color:#3D2B1F; font-size:14px; font-family:'Poppins',sans-serif;
            cursor:pointer; text-align:left;
        }
        .country-trigger:hover, .country-picker.open .country-trigger {
            border-color:#C47D1E; box-shadow:0 0 0 3px rgba(196,125,30,0.12);
        }
        .country-trigger-text { display:flex; align-items:center; gap:8px; min-width:0; }
        .country-trigger-code { color:#A87D50; font-size:12px; font-weight:600; }
        .country-trigger i { color:#C47D1E; font-size:13px; transition:transform 0.2s; }
        .country-picker.open .country-trigger i { transform:rotate(180deg); }
        .country-menu {
            display:none; position:absolute; z-index:30; top:calc(100% + 6px);
            left:0; right:0; padding:7px; background:#fff; border:1px solid #E8D5B0;
            border-radius:12px; box-shadow:0 10px 24px rgba(61,43,31,0.16);
        }
        .country-picker.open .country-menu { display:block; }
        .country-search-wrap { position:relative; margin-bottom:7px; }
        .country-search-wrap i {
            position:absolute; left:13px; top:50%; transform:translateY(-50%);
            color:#B09070; font-size:13px; pointer-events:none;
        }
        .country-search {
            width:100%; height:42px; background:#FBF5EC; border:1.5px solid #E8D5B0;
            border-radius:10px; padding:10px 12px 10px 36px; color:#3D2B1F;
            font-size:13px; font-family:'Poppins',sans-serif; outline:none;
        }
        .country-search:focus, .custom-indicatif:focus {
            border-color:#C47D1E; box-shadow:0 0 0 3px rgba(196,125,30,0.12);
        }
        .country-options {
            max-height:224px; overflow-y:auto; padding:0; background:#FBF5EC;
            border:1px solid #E8D5B0; border-radius:10px;
            scrollbar-width:thin; scrollbar-color:#D5B27B transparent;
        }
        .country-option {
            width:100%; min-height:41px; display:flex; align-items:center;
            justify-content:space-between; gap:10px; padding:9px 11px;
            background:transparent; border:0; border-radius:8px; color:#3D2B1F;
            text-align:left; font-size:13px; font-family:'Poppins',sans-serif;
            cursor:pointer; transition:background 0.15s, color 0.15s;
        }
        .country-option + .country-option { margin-top:2px; }
        .country-option:hover { background:#FEF3DA; }
        .country-option.active { background:#C47D1E; color:#fff; font-weight:700; }
        .country-option-code { font-size:11px; opacity:0.7; font-weight:600; }
        .country-option.active .country-option-code { opacity:0.9; }
        .country-empty {
            padding:12px; color:#A87D50; font-size:12px; text-align:center;
        }
        .custom-indicatif {
            width:100%; height:50px; background:#FBF5EC; border:1.5px solid #E8D5B0;
            border-radius:14px; padding:13px; color:#3D2B1F; font-size:14px;
            font-family:'Poppins',sans-serif; outline:none; margin-bottom:8px;
        }
        .input-wrap.locked { background:#F3ECDE; border-color:#D9C49A; }
        .input-wrap.locked input {
            color:#7D5A38; font-weight:600; cursor:not-allowed;
        }
        .lock-icon {
            width:40px; display:flex; align-items:center; justify-content:center;
            color:#A87D50; font-size:14px; flex-shrink:0;
        }
        .eye-toggle {
            position:absolute; right:0; top:0; bottom:0;
            background:none; border:none; cursor:pointer;
            color:#A87D50; font-size:16px;
            display:flex; align-items:center; justify-content:center;
            width:44px; z-index:2;
        }
        .error-box {
            background:#FFF0EE; border:1px solid #F5A9A0; border-radius:12px;
            padding:12px 16px; margin-bottom:18px; color:#C0392B;
            font-size:13px; display:flex; align-items:center; gap:10px;
        }
        .btn-submit {
            width:100%; padding:16px;
            background:linear-gradient(135deg,#D4921F,#B07018);
            border:none; border-radius:16px;
            font-size:16px; font-weight:700; color:#fff;
            cursor:pointer; margin-top:8px;
            box-shadow:0 6px 20px rgba(196,125,30,0.4);
            transition:transform 0.2s; font-family:'Poppins',sans-serif;
        }
        .btn-submit:hover { transform:translateY(-2px); }
        .login-link { text-align:center; margin-top:20px; font-size:13px; color:#A87D50; }
        .login-link a { color:#C47D1E; font-weight:600; text-decoration:none; }
    </style>
    <link rel="stylesheet" href="/assets/dangote-theme.css">
</head>
<body>
<%- include('partials/language') %>
    <div class="hero" data-auth-hero>
        <div class="hero-slideshow" aria-hidden="true">
            <img class="hero-slide active" src="/images/dangote-hero-1.jpeg" alt="">
            <img class="hero-slide" src="/images/dangote-hero-2.jpg" alt="">
            <img class="hero-slide" src="/images/dangote-hero-3.jpeg" alt="">
            <img class="hero-slide" src="/images/dangote-hero-4.jpeg" alt="">
            <img class="hero-slide" src="/images/dangote-hero-5.jpeg" alt="">
            <img class="hero-slide" src="/images/dangote-hero-6.jpeg" alt="">
        </div>
        <div class="hero-logo"><img src="/images/dangote-logo.png" alt="Dangote"></div>
        <h1>Groupe Dangote (GD)</h1>
        <p>« Ensemble, construisons la richesse de demain. »</p>
    </div>

    <div class="form-card">
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="error-box"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
        <% } %>

        <% if (typeof code_parrain !== 'undefined' && code_parrain) { %>
            <div class="referral-notice"><i class="fas fa-user-friends"></i> Vous êtes invité par un ambassadeur Groupe Dangote (GD)</div>
        <% } %>

        <div class="form-title">Rejoignez Groupe Dangote</div>

        <form action="/inscription1" method="post" id="signup-form">
            <% if (typeof code_parrain !== 'undefined' && code_parrain) { %>
            <div class="form-group">
                <label class="form-label">Code d'invitation</label>
                <div class="input-wrap locked">
                    <div class="input-icon"><i class="fas fa-ticket-alt"></i></div>
                    <input type="text" value="<%= code_parrain %>" readonly tabindex="-1">
                    <div class="lock-icon"><i class="fas fa-lock"></i></div>
                </div>
            </div>
            <% } %>

            <div class="form-group">
                <label class="form-label">Nom complet</label>
                <div class="input-wrap">
                    <div class="input-icon"><i class="fas fa-user"></i></div>
                    <input type="text" name="nom" placeholder="Votre nom complet" required
                           value="<%= (typeof form_data !== 'undefined' && form_data) ? form_data.nom : '' %>">
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Numéro WhatsApp</label>
                <div class="country-picker" id="countryPicker">
                    <button type="button" class="country-trigger" id="countryTrigger"
                            aria-haspopup="listbox" aria-expanded="false">
                        <span class="country-trigger-text">
                            <span id="countrySelectedLabel">Cameroun</span>
                            <span class="country-trigger-code" id="countrySelectedCode">+237</span>
                        </span>
                        <i class="fas fa-chevron-down" aria-hidden="true"></i>
                    </button>
                    <div class="country-menu" id="countryMenu">
                        <div class="country-search-wrap">
                            <i class="fas fa-search"></i>
                            <input type="search" id="countrySearch" class="country-search"
                                   placeholder="Rechercher un pays" autocomplete="off"
                                   aria-label="Rechercher un pays">
                        </div>
                        <div class="country-options" id="countryOptions" role="listbox" aria-label="Pays disponibles">
                            <% Object.entries(pays_eligibles).forEach(([code, pays]) => { %>
                            <button type="button" class="country-option"
                                    data-code="<%= code %>" data-name="<%= pays %>"
                                    role="option" aria-selected="false">
                                <span><%= pays %></span><span class="country-option-code"><%= code %></span>
                            </button>
                            <% }) %>
                            <button type="button" class="country-option"
                                    data-code="__other__" data-name="Autre"
                                    role="option" aria-selected="false">
                                <span>Autre</span><span class="country-option-code">Indicatif personnalisé</span>
                            </button>
                            <div class="country-empty" id="countryEmpty" hidden>Aucun pays trouvé.</div>
                        </div>
                    </div>
                </div>
                <input type="hidden" name="indicatif" id="indicatif"
                       value="<%= (typeof form_data !== 'undefined' && form_data && form_data.indicatif) ? form_data.indicatif : '+237' %>">
                <input type="text" id="customIndicatif" class="custom-indicatif"
                       placeholder="Indicatif de pays (ex. +221)" inputmode="tel"
                       autocomplete="tel-country-code" hidden>
                <div class="input-wrap">
                    <div class="input-icon"><i class="fas fa-phone"></i></div>
                    <input type="text" id="telephone" name="telephone" placeholder="Numéro de téléphone" required pattern="[0-9 ]{6,}"
                           value="<%= (typeof form_data !== 'undefined' && form_data) ? form_data.telephone : '' %>">
                </div>
                <input type="hidden" name="pays" id="pays" value="">
            </div>

            <div class="form-group">
                <label class="form-label">Mot de passe</label>
                <div class="input-wrap">
                    <div class="input-icon"><i class="fas fa-lock"></i></div>
                    <input type="password" id="mot_de_passe" name="mot_de_passe" placeholder="Choisissez un mot de passe" required>
                    <button type="button" class="eye-toggle" onclick="togglePwd('mot_de_passe',this)"><i class="fas fa-eye"></i></button>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Confirmer le mot de passe</label>
                <div class="input-wrap">
                    <div class="input-icon"><i class="fas fa-lock"></i></div>
                    <input type="password" id="confirmation" name="confirmation" placeholder="Confirmez le mot de passe" required>
                    <button type="button" class="eye-toggle" onclick="togglePwd('confirmation',this)"><i class="fas fa-eye"></i></button>
                </div>
            </div>

            <button type="submit" class="btn-submit"><i class="fas fa-user-plus"></i> Créer mon compte</button>
        </form>

        <div class="login-link">Déjà membre ? <a href="/connexion">Se connecter</a></div>
    </div>

    <script>
        const indicatifInput = document.getElementById('indicatif');
        const customIndicatif = document.getElementById('customIndicatif');
        const paysInput = document.getElementById('pays');
        const paysMap = <%- JSON.stringify(pays_eligibles) %>;
        const countryPicker = document.getElementById('countryPicker');
        const countryTrigger = document.getElementById('countryTrigger');
        const countryLabel = document.getElementById('countrySelectedLabel');
        const countryCodeLabel = document.getElementById('countrySelectedCode');
        const countrySearch = document.getElementById('countrySearch');
        const countryEmpty = document.getElementById('countryEmpty');
        const countryOptions = Array.from(document.querySelectorAll('.country-option'));
        const otherOption = countryOptions.find(option => option.dataset.code === '__other__');

        function toggleCountryMenu(open) {
            countryPicker.classList.toggle('open', open);
            countryTrigger.setAttribute('aria-expanded', open ? 'true' : 'false');
            if (open) countrySearch.focus();
        }

        function normalizeIndicatif(value) {
            const digits = String(value || '').replace(/\D/g, '');
            return digits ? `+${digits}` : '';
        }

        function updateOtherIndicator() {
            const normalized = normalizeIndicatif(customIndicatif.value);
            if (customIndicatif.value !== normalized) customIndicatif.value = normalized;

            const knownOption = countryOptions.find(option => option.dataset.code === normalized);
            if (knownOption) {
                selectCountry(knownOption);
                return;
            }

            indicatifInput.value = normalized;
            countryCodeLabel.textContent = normalized || 'Indicatif requis';
            paysInput.value = 'Autre';
        }

        function selectCountry(option) {
            const isOther = option.dataset.code === '__other__';
            countryOptions.forEach(item => {
                const selected = item === option;
                item.classList.toggle('active', selected);
                item.setAttribute('aria-selected', selected ? 'true' : 'false');
            });
            countryLabel.textContent = option.dataset.name;
            customIndicatif.hidden = !isOther;
            customIndicatif.required = isOther;
            if (isOther) {
                updateOtherIndicator();
                customIndicatif.focus();
            } else {
                indicatifInput.value = option.dataset.code;
                countryCodeLabel.textContent = option.dataset.code;
                paysInput.value = paysMap[option.dataset.code] || '';
            }
            if (isOther) paysInput.value = 'Autre';
            toggleCountryMenu(false);
        }

        countryTrigger.addEventListener('click', () => {
            toggleCountryMenu(!countryPicker.classList.contains('open'));
        });
        countryOptions.forEach(option => {
            option.addEventListener('click', () => selectCountry(option));
        });
        customIndicatif.addEventListener('input', updateOtherIndicator);
        countrySearch.addEventListener('input', function () {
            const query = this.value.trim().toLocaleLowerCase('fr-FR');
            let visibleCount = 0;
            countryOptions.forEach(option => {
                const matches = !query
                    || option.dataset.name.toLocaleLowerCase('fr-FR').includes(query)
                    || option.dataset.code.toLocaleLowerCase('fr-FR').includes(query);
                option.hidden = !matches;
                if (matches) visibleCount += 1;
            });
            countryEmpty.hidden = visibleCount !== 0;
        });

        const initialIndicatif = indicatifInput.value.trim() || '+237';
        const initialOption = countryOptions.find(option => option.dataset.code === initialIndicatif);
        if (initialOption) {
            selectCountry(initialOption);
        } else {
            customIndicatif.value = initialIndicatif;
            selectCountry(otherOption);
        }
        document.addEventListener('click', event => {
            if (!countryPicker.contains(event.target)) toggleCountryMenu(false);
        });
        document.addEventListener('keydown', event => {
            if (event.key === 'Escape') toggleCountryMenu(false);
        });

        function togglePwd(id, btn) {
            const inp = document.getElementById(id);
            if (inp.type === 'password') { inp.type = 'text'; btn.innerHTML = '<i class="fas fa-eye-slash"></i>'; }
            else { inp.type = 'password'; btn.innerHTML = '<i class="fas fa-eye"></i>'; }
        }
    </script>
    <script src="/assets/auth-hero-slideshow.js"></script>
</body>
</html>
