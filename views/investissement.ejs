<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Plans d'Investissement - Groupe Dangote (GD)</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        * { margin:0; padding:0; box-sizing:border-box; font-family:'Poppins','Segoe UI',sans-serif; }
        body { background:#F5EFE6; color:#3D2B1F; min-height:100vh; overflow-x:hidden; padding-bottom:90px; }
        .container { max-width:430px; margin:0 auto; }

        /* Header */
        .page-header {
            background: linear-gradient(135deg, #D4921F, #A0631A);
            padding: 50px 20px 20px;
            display: flex; align-items: center; gap: 14px;
        }
        .back-btn {
            width:36px; height:36px; border-radius:50%;
            background:rgba(255,255,255,0.2); display:flex; align-items:center; justify-content:center;
            color:#fff; text-decoration:none; font-size:16px; flex-shrink:0;
        }
        .page-header h1 { font-size:20px; font-weight:700; color:#fff; }

        /* Tab nav */
        .tab-nav {
            background:#fff; border-bottom:1px solid #E8D5B0;
            display:flex; position:sticky; top:0; z-index:10;
        }
        .tab-btn {
            flex:1; padding:14px; text-align:center; cursor:pointer;
            font-size:14px; font-weight:600; color:#A87D50;
            border-bottom:3px solid transparent; transition:all 0.2s;
            display:flex; align-items:center; justify-content:center; gap:8px;
        }
        .tab-btn.active { color:#C47D1E; border-bottom-color:#C47D1E; }

        /* Plans */
        .main-content { padding:16px; }
        .plans-list { display:flex; flex-direction:column; gap:20px; }
        .plan-card {
            background:#fff; border-radius:20px;
            overflow:hidden; box-shadow:0 4px 16px rgba(196,125,30,0.12);
            transition:transform 0.2s, box-shadow 0.2s;
        }
        .plan-card:hover { transform:translateY(-4px); box-shadow:0 8px 28px rgba(196,125,30,0.20); }
        .plan-image-wrap { position:relative; height:160px; overflow:hidden; background:#000; }
        .plan-image-wrap img { width:100%; height:100%; object-fit:contain; }
        .plan-duration-badge {
            position:absolute; top:12px; right:12px;
            background:linear-gradient(135deg,#D4921F,#B07018);
            color:#fff; font-size:12px; font-weight:700;
            padding:5px 12px; border-radius:20px;
            box-shadow:0 2px 8px rgba(0,0,0,0.25);
        }
        .plan-body { padding:16px; }
        .plan-name { font-size:18px; font-weight:700; color:#C47D1E; margin-bottom:12px; }
        .plan-stats {
            background:#FBF5EC; border-radius:12px; padding:12px; margin-bottom:14px;
            display:grid; grid-template-columns:1fr 1fr; gap:8px;
        }
        .stat-cell { }
        .stat-val { font-size:16px; font-weight:800; color:#C47D1E; }
        .stat-lbl { font-size:11px; color:#A87D50; margin-top:1px; }
        .plan-footer {
            display:flex; align-items:center; justify-content:space-between;
            padding-top:12px; border-top:1px solid #F0E0C8;
        }
        .plan-price { font-size:14px; color:#7D5A38; }
        .plan-price strong { font-size:18px; font-weight:800; color:#3D2B1F; }
        .btn-invest {
            background:linear-gradient(135deg,#D4921F,#B07018);
            color:#fff; border:none; border-radius:12px;
            padding:11px 24px; font-size:14px; font-weight:700;
            cursor:pointer; box-shadow:0 4px 12px rgba(196,125,30,0.4);
            transition:transform 0.2s; font-family:'Poppins',sans-serif;
        }
        .btn-invest:hover { transform:translateY(-2px); }
        .btn-invest:disabled { cursor:not-allowed; opacity:0.55; }
        .plan-price small { color:#A87D50; font-size:10px; }

        /* Locked plan */
        .plan-card.locked { position:relative; }
        .plan-card.locked .plan-image-wrap::after {
            content:'Bientôt disponible'; position:absolute; inset:0;
            background:rgba(20,15,8,0.62); color:#fff; font-weight:800; font-size:15px;
            display:flex; align-items:center; justify-content:center; text-align:center;
            letter-spacing:0.3px;
        }
        .plan-card.locked .btn-invest {
            filter:blur(1.5px); opacity:0.65; position:relative;
        }
        .plan-card.locked .btn-invest-lock {
            position:absolute; right:24px; top:50%; transform:translateY(-50%);
            background:#dc2626; color:#fff; width:22px; height:22px; border-radius:50%;
            display:flex; align-items:center; justify-content:center; font-size:11px;
            box-shadow:0 2px 6px rgba(0,0,0,0.3); pointer-events:none;
        }

        /* Empty state */
        .empty-state { text-align:center; padding:60px 20px; }
        .empty-icon { font-size:52px; color:#E8D5B0; margin-bottom:16px; }
        .empty-title { font-size:18px; font-weight:600; color:#7D5A38; margin-bottom:8px; }
        .empty-msg { font-size:14px; color:#A87D50; }

        /* Order cards (Mes Commandes) */
        .order-card {
            background:#fff; border-radius:20px; padding:18px;
            box-shadow:0 4px 16px rgba(196,125,30,0.12);
        }
        .order-head { display:flex; align-items:center; gap:12px; margin-bottom:14px; }
        .order-img { width:52px; height:52px; border-radius:12px; overflow:hidden; flex-shrink:0; }
        .order-img img { width:100%; height:100%; object-fit:cover; }
        .order-name { font-size:16px; font-weight:700; color:#C47D1E; }
        .order-amount { font-size:13px; color:#7D5A38; margin-top:2px; }
        .order-amount strong { color:#3D2B1F; }
        .progress-row { margin-bottom:10px; }
        .progress-labels { display:flex; justify-content:space-between; font-size:12px; color:#A87D50; margin-bottom:6px; }
        .progress-track { background:#F0E0C8; border-radius:20px; height:10px; overflow:hidden; }
        .progress-fill { height:100%; border-radius:20px; background:linear-gradient(135deg,#D4921F,#B07018); transition:width 0.4s ease; }
        .countdown-box {
            display:flex; align-items:center; justify-content:center; gap:8px;
            background:#FBF5EC; border:1px solid #E8D5B0; border-radius:12px;
            padding:10px; font-size:15px; font-weight:800; color:#C47D1E;
        }
        .countdown-box.ready { background:#F0FFF4; border-color:#86EFAC; color:#166534; }

        /* Popup */
        .popup {
            display:none; position:fixed; inset:0;
            background:rgba(0,0,0,0.55); backdrop-filter:blur(8px);
            z-index:1000; align-items:center; justify-content:center; padding:20px;
        }
        .popup-box {
            background:#fff; width:100%; max-width:370px;
            border-radius:24px; overflow:hidden;
            box-shadow:0 24px 60px rgba(0,0,0,0.25);
        }
        .popup-head {
            padding:20px; background:linear-gradient(135deg,#D4921F,#B07018);
            display:flex; justify-content:space-between; align-items:center;
        }
        .popup-head h3 { font-size:17px; font-weight:700; color:#fff; }
        .popup-close-btn {
            width:30px; height:30px; border-radius:50%;
            background:rgba(255,255,255,0.25); border:none; color:#fff;
            font-size:18px; cursor:pointer; display:flex; align-items:center; justify-content:center;
        }
        .popup-body { padding:24px 20px; }
        .popup-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:20px; }
        .popup-stat {
            background:#FBF5EC; border:1px solid #E8D5B0;
            border-radius:12px; padding:14px; text-align:center;
        }
        .popup-stat-val { font-size:17px; font-weight:800; color:#C47D1E; margin-bottom:4px; }
        .popup-stat-lbl { font-size:12px; color:#A87D50; }
        .btn-confirm {
            width:100%; padding:16px; border:none; border-radius:14px;
            background:linear-gradient(135deg,#D4921F,#B07018);
            color:#fff; font-size:16px; font-weight:700;
            cursor:pointer; font-family:'Poppins',sans-serif;
            box-shadow:0 6px 18px rgba(196,125,30,0.4); transition:transform 0.2s;
        }
        .btn-confirm:hover { transform:translateY(-2px); }

        .share-count-box {
            background:#FBF5EC; border:1px solid #E8D5B0; border-radius:14px;
            padding:14px; margin-bottom:18px;
        }
        .share-count-box label {
            display:block; font-size:12px; font-weight:700; color:#7D5A38;
            margin-bottom:7px;
        }
        .share-count-box input {
            width:100%; border:1px solid #E8D5B0; border-radius:10px;
            padding:11px 12px; font:600 15px 'Poppins',sans-serif; color:#3D2B1F;
            background:#fff; outline:none;
        }
        .share-count-box input:focus { border-color:#C47D1E; }
        .share-count-help {
            font-size:11px; color:#A87D50; margin-top:7px; line-height:1.45;
        }
        .purchase-mode {
            display:flex; gap:8px; margin-bottom:12px;
        }
        .purchase-mode-btn {
            flex:1; padding:9px 8px; border:1px solid #E8D5B0; border-radius:9px;
            background:#fff; color:#7D5A38; font:600 11px 'Poppins',sans-serif;
            cursor:pointer;
        }
        .purchase-mode-btn.active {
            background:#14105F; border-color:#14105F; color:#fff;
        }
        .purchase-input-label { display:block; }
        .popup-balance-warning {
            display:none; margin-top:8px; padding:8px 10px; border-radius:8px;
            background:#FFF0EE; border:1px solid #F5A9A0; color:#C0392B;
            font-size:11px; line-height:1.45;
        }

        /* Insufficient balance */
        .floater-overlay {
            display:none; position:fixed; inset:0;
            background:rgba(0,0,0,0.6); backdrop-filter:blur(8px);
            z-index:2000; align-items:center; justify-content:center; padding:20px;
        }
        .floater-box {
            background:#fff; max-width:340px; width:100%;
            border-radius:24px; padding:36px 24px; text-align:center;
            box-shadow:0 24px 60px rgba(0,0,0,0.25);
        }
        .floater-icon { font-size:56px; margin-bottom:16px; }
        .floater-title { font-size:20px; font-weight:700; color:#3D2B1F; margin-bottom:10px; }
        .floater-msg { font-size:14px; color:#7D5A38; line-height:1.6; margin-bottom:24px; }
        .floater-btns { display:flex; gap:12px; }
        .floater-btn {
            flex:1; padding:14px; border:none; border-radius:12px;
            font-size:15px; font-weight:600; cursor:pointer; font-family:'Poppins',sans-serif;
        }
        .floater-primary { background:linear-gradient(135deg,#D4921F,#B07018); color:#fff; }
        .floater-secondary { background:#FBF5EC; border:1.5px solid #E8D5B0; color:#7D5A38; }

        .alert-msg { padding:12px 16px; border-radius:10px; margin-bottom:16px; font-size:14px; display:none; }
        .alert-error { background:#FFF0EE; border:1px solid #F5A9A0; color:#C0392B; }
        .alert-success { background:#F0FFF4; border:1px solid #86EFAC; color:#166534; }
    </style>
    <link rel="stylesheet" href="/assets/dangote-theme.css">
</head>
<body>
<%- include('partials/menu', { page: 'investissement' }) %>

<div class="container">
    <div class="page-header">
        <a href="/" class="back-btn"><i class="fas fa-chevron-left"></i></a>
        <h1>Plans d'Investissement</h1>
    </div>

    <div class="tab-nav">
        <div class="tab-btn vip <%= menu_actif === 'vip' ? 'active' : '' %>" data-menu="vip">
            <i class="fas fa-crown"></i> Actions VIP
        </div>
        <div class="tab-btn commande <%= menu_actif === 'commande' ? 'active' : '' %>" data-menu="commande">
            <i class="fas fa-shopping-bag"></i> Mes Commandes
        </div>
    </div>

    <div class="main-content">
        <div id="alertMessage" class="alert-msg"></div>

        <div class="contenu-tab <%= menu_actif === 'vip' ? '' : 'hidden' %>" id="vip-content">
            <div class="plans-list">
                <% if (plans && plans.length > 0) { %>
                    <% plans.forEach(function(plan, idx) { %>
                    <% const achatsEffectues = Number((achatsParPlan && achatsParPlan[plan.id]) || 0);
                       const achatsRestants = Math.max(0, (maxAchatsParPlan || 3) - achatsEffectues);
                    %>
                    <div class="plan-card<%= plan.bloque ? ' locked' : '' %>">
                        <div class="plan-image-wrap">
                            <img src="<%= plan.image_url || '/images/dangote-logo.png' %>" alt="<%= plan.nom %>">
                            <div class="plan-duration-badge"><%= plan.duree_jours %> Jours</div>
                        </div>
                        <div class="plan-body">
                            <div class="plan-name"><%= plan.nom %></div>
                            <div class="plan-stats">
                                <div class="stat-cell">
                                    <div class="stat-val">
                                        <span data-currency-amount="<%= Number(plan.prix_action || 0) %>"><%= plan.prix_action.toLocaleString('fr-FR') %></span>
                                        <span data-currency-code>FCFA</span>
                                    </div>
                                    <div class="stat-lbl">Prix / action</div>
                                </div>
                                <div class="stat-cell">
                                    <div class="stat-val"><%= plan.taux_minimum %>–<%= plan.taux_maximum %>%</div>
                                    <div class="stat-lbl">Gain quotidien</div>
                                </div>
                            </div>
                            <div class="plan-footer">
                                <div class="plan-price">
                                    Minimum :
                                    <strong>
                                        <span data-currency-amount="<%= Number(plan.prix || 0) %>"><%= plan.prix.toLocaleString('fr-FR') %></span>
                                        <span data-currency-code>FCFA</span>
                                    </strong><br>
                                    <small><%= achatsEffectues %>/<%= maxAchatsParPlan || 3 %> achat(s)</small>
                                </div>
                                <% if (plan.bloque) { %>
                                <button class="btn-invest btn-invest-locked" type="button" onclick="showPlanLockedMsg()">
                                    Investir
                                </button>
                                <span class="btn-invest-lock"><i class="fas fa-lock"></i></span>
                                <% } else { %>
                                <button class="btn-invest"
                                    data-plan-id="<%= plan.id %>"
                                    data-nom="<%= plan.nom %>"
                                    data-prix="<%= plan.prix %>"
                                    data-prix-action="<%= plan.prix_action %>"
                                    data-actions-minimum="<%= plan.actions_minimum %>"
                                    data-strategie='<%- JSON.stringify(plan.strategie) %>'
                                    data-duree="<%= plan.duree_jours %>"
                                    data-achats-restants="<%= achatsRestants %>"
                                    <%= achatsRestants === 0 ? 'disabled' : '' %>>
                                    <%= achatsRestants === 0 ? 'Limite atteinte' : 'Investir' %>
                                </button>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <% }); %>
                <% } else { %>
                    <div class="empty-state">
                        <div class="empty-icon"><i class="fas fa-chart-bar"></i></div>
                        <div class="empty-title">Aucun Plan Disponible</div>
                        <div class="empty-msg">Les plans d'investissement ne sont pas encore configurés.</div>
                    </div>
                <% } %>
            </div>
        </div>

        <div class="contenu-tab <%= menu_actif === 'commande' ? '' : 'hidden' %>" id="commande-content">
            <div class="plans-list">
                <% if (commandes && commandes.length > 0) { %>
                    <% commandes.forEach(function(cmd) { %>
                    <div class="order-card">
                        <div class="order-head">
                            <div class="order-img"><img src="<%= cmd.plan_image || '/images/dangote-logo.png' %>" alt="<%= cmd.plan_nom %>"></div>
                            <div>
                                <div class="order-name"><%= cmd.plan_nom %></div>
                            <div class="order-amount">
                                Montant investi :
                                <strong>
                                    <span data-currency-amount="<%= Number(cmd.montant || 0) %>"><%= parseFloat(cmd.montant).toLocaleString('fr-FR') %></span>
                                    <span data-currency-code>FCFA</span>
                                </strong>
                                <% if (cmd.nombre_actions && Number(cmd.nombre_actions) > 1) { %>
                                    · <strong><%= cmd.nombre_actions %> actions</strong>
                                <% } %>
                            </div>
                            </div>
                        </div>
                        <div class="progress-row">
                            <div class="progress-labels">
                                <span>Cycle de versement (24h)</span>
                                <span class="progress-pct" data-start="<%= cmd.cycle_start_ms %>" data-end="<%= cmd.cycle_end_ms %>">0%</span>
                            </div>
                            <div class="progress-track">
                                <div class="progress-fill" style="width:0%" data-start="<%= cmd.cycle_start_ms %>" data-end="<%= cmd.cycle_end_ms %>"></div>
                            </div>
                        </div>
                        <div class="countdown-box" data-end="<%= cmd.cycle_end_ms %>">
                            <i class="fas fa-clock"></i> <span class="countdown-text">--:--:--</span>
                        </div>
                    </div>
                    <% }); %>
                <% } else { %>
                    <div class="empty-state">
                        <div class="empty-icon"><i class="fas fa-shopping-bag"></i></div>
                        <div class="empty-title">Aucune Commande Active</div>
                        <div class="empty-msg">Investissez dans un plan pour le voir apparaître ici.</div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<!-- Invest Popup -->
<div class="popup" id="investPopup">
    <div class="popup-box">
        <div class="popup-head">
            <h3 id="popup-titre">Confirmer l'investissement</h3>
            <button class="popup-close-btn" onclick="fermerPopup()">&times;</button>
        </div>
        <div class="popup-body">
            <div class="share-count-box">
                <div class="purchase-mode">
                    <button type="button" class="purchase-mode-btn active" data-mode="actions">Nombre d'actions</button>
                    <button type="button" class="purchase-mode-btn" data-mode="amount">Montant FCFA</button>
                </div>
                <label class="purchase-input-label" id="popup-actions-label" for="popup-actions">Nombre d'actions</label>
                <input id="popup-actions" type="number" min="10" step="0.1" value="10" inputmode="decimal">
                <input id="popup-amount" type="number" min="0" step="0.01" value="0" inputmode="decimal" style="display:none;">
                <div class="share-count-help" id="popup-actions-help"></div>
                <div class="popup-balance-warning" id="popup-balance-warning"></div>
            </div>
            <div class="popup-grid">
                <div class="popup-stat">
                    <div class="popup-stat-val" id="popup-prix">0 FCFA</div>
                    <div class="popup-stat-lbl">Montant de départ</div>
                </div>
                <div class="popup-stat">
                    <div class="popup-stat-val" id="popup-gain-journalier">0 FCFA</div>
                    <div class="popup-stat-lbl">Gain quotidien</div>
                </div>
                <div class="popup-stat">
                    <div class="popup-stat-val" id="popup-duree">0 jours</div>
                    <div class="popup-stat-lbl">Durée totale</div>
                </div>
                <div class="popup-stat">
                    <div class="popup-stat-val" id="popup-gain-total">0 FCFA</div>
                    <div class="popup-stat-lbl">Gain total</div>
                </div>
            </div>
            <button class="btn-confirm" id="confirmerInvestBtn">Confirmer l'achat</button>
        </div>
    </div>
</div>

<!-- Success Popup -->
<div class="popup" id="successPopup" style="display:none;">
    <div class="popup-box" style="text-align:center; padding: 32px 24px;">
        <div style="width:72px;height:72px;background:#c8820a;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 18px;">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <h3 style="color:#c8820a;font-size:1.25rem;margin-bottom:8px;">Achat effectué avec succès !</h3>
            <p id="success-plan-name" style="font-weight:700;font-size:1.05rem;margin-bottom:6px;color:#333;"></p>
        <p style="color:#666;font-size:0.93rem;margin-bottom:20px;">Votre investissement est maintenant actif. Les gains seront crédités quotidiennement.</p>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:22px;">
            <div style="background:#fdf5e6;border-radius:10px;padding:12px;">
                <div id="success-montant" style="font-weight:800;font-size:1.1rem;color:#c8820a;"></div>
                <div style="font-size:0.78rem;color:#888;">Montant investi</div>
            </div>
            <div style="background:#fdf5e6;border-radius:10px;padding:12px;">
                <div id="success-gain" style="font-weight:800;font-size:1.1rem;color:#c8820a;"></div>
                <div style="font-size:0.78rem;color:#888;">Gain / jour</div>
            </div>
        </div>
        <button class="btn-confirm" onclick="fermerSuccessPopup()">OK</button>
    </div>
</div>

<!-- Plan locked -->
<div class="floater-overlay" id="planLockedFloater">
    <div class="floater-box">
        <div class="floater-icon"><i class="fas fa-lock" style="color:#c8820a;"></i></div>
        <div class="floater-title">Plan non disponible</div>
        <div class="floater-msg">Ce plan n'est pas encore disponible, il sera bientôt disponible sur le marché ! Profitez des plans actifs actuellement.</div>
        <div class="floater-btns">
            <button class="floater-btn floater-primary" onclick="document.getElementById('planLockedFloater').style.display='none'">J'ai compris</button>
        </div>
    </div>
</div>

<!-- Insufficient Balance -->
<div class="floater-overlay" id="insufficientBalanceFloater">
    <div class="floater-box">
        <div class="floater-icon"><i class="fas fa-coins" style="color:#c8820a;"></i></div>
        <div class="floater-title">Solde Insuffisant</div>
        <div class="floater-msg">
            Votre solde actuel est de
            <strong>
                <span data-currency-amount="<%= Number(solde || 0) %>"><%= solde.toLocaleString('fr-FR') %></span>
                <span data-currency-code>FCFA</span>
            </strong>.
            Veuillez recharger pour continuer.
        </div>
        <div class="floater-btns">
            <button class="floater-btn floater-primary" onclick="window.location.href='/depot'">Recharger</button>
            <button class="floater-btn floater-secondary" onclick="document.getElementById('insufficientBalanceFloater').style.display='none'">Annuler</button>
        </div>
    </div>
</div>

<style>.hidden { display:none; }</style>
<script>
let currentPlan = null;
let purchaseMode = 'actions';
const soldeClient = <%= solde %>;

document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', function() {
        const target = this.getAttribute('data-menu');
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.contenu-tab').forEach(c => c.classList.add('hidden'));
        this.classList.add('active');
        document.getElementById(target + '-content').classList.remove('hidden');
        const url = new URL(window.location);
        url.searchParams.set('menu', target);
        window.history.replaceState({}, '', url);
    });
});

function pad(n) { return n.toString().padStart(2, '0'); }
function translateDynamic(value) {
    return window.GDLanguage ? window.GDLanguage.translate(value) : value;
}

function updateOrderTimers() {
    const now = Date.now();
    document.querySelectorAll('.progress-fill').forEach(el => {
        const start = parseInt(el.dataset.start, 10);
        const end = parseInt(el.dataset.end, 10);
        const pct = Math.max(0, Math.min(100, ((now - start) / (end - start)) * 100));
        el.style.width = pct + '%';
    });
    document.querySelectorAll('.progress-pct').forEach(el => {
        const start = parseInt(el.dataset.start, 10);
        const end = parseInt(el.dataset.end, 10);
        const pct = Math.max(0, Math.min(100, ((now - start) / (end - start)) * 100));
        el.textContent = Math.round(pct) + '%';
    });
    document.querySelectorAll('.countdown-box').forEach(box => {
        const end = parseInt(box.dataset.end, 10);
        const remaining = end - now;
        const textEl = box.querySelector('.countdown-text');
        if (remaining <= 0) {
            box.classList.add('ready');
            textEl.textContent = translateDynamic('Versement disponible !');
        } else {
            box.classList.remove('ready');
            const h = Math.floor(remaining / 3600000);
            const m = Math.floor((remaining % 3600000) / 60000);
            const s = Math.floor((remaining % 60000) / 1000);
            textEl.textContent = pad(h) + ':' + pad(m) + ':' + pad(s) + ' ' +
                translateDynamic('avant versement');
        }
    });
}
if (document.querySelector('.countdown-box')) {
    updateOrderTimers();
    setInterval(updateOrderTimers, 1000);
    window.addEventListener('gd-language-change', updateOrderTimers);
}

document.querySelectorAll('.btn-invest:not(.btn-invest-locked)').forEach(btn => {
    btn.addEventListener('click', function() {
        window.location.href = `/investissement/action/${encodeURIComponent(this.dataset.planId)}`;
    });
});

function ouvrirPopup(plan) {
    document.getElementById('popup-titre').textContent = plan.nom;
    const actionsInput = document.getElementById('popup-actions');
    actionsInput.min = plan.actionsMinimum;
    actionsInput.value = plan.actionsMinimum;
    document.getElementById('popup-amount').value =
        (plan.actionsMinimum * plan.prixAction).toFixed(2);
    setPurchaseMode('actions');
    document.getElementById('popup-actions-help').textContent =
        `1 action = ${displayMoney(plan.prixAction)}/action · minimum ${plan.actionsMinimum} actions · ${plan.achatsRestants} achat(s) restant(s)`;
    updatePurchaseSummary();
    document.getElementById('investPopup').style.display = 'flex';
}

function parseDecimal(value) {
    const normalized = String(value ?? '').trim().replace(',', '.');
    return normalized ? Number(normalized) : NaN;
}

function displayMoney(value) {
    const currency = window.GDCurrency ? window.GDCurrency.getCurrency() : 'FCFA';
    const formatted = window.GDCurrency
        ? window.GDCurrency.formatAmount(value, currency)
        : Number(value || 0).toLocaleString('fr-FR', { maximumFractionDigits: 2 });
    return `${formatted} ${currency}`;
}

function roundActions(value) {
    return Math.round(value * 10000) / 10000;
}

function setPurchaseMode(mode) {
    purchaseMode = mode;
    document.querySelectorAll('.purchase-mode-btn').forEach((button) => {
        button.classList.toggle('active', button.dataset.mode === mode);
    });
    const actionsInput = document.getElementById('popup-actions');
    const amountInput = document.getElementById('popup-amount');
    const actionsLabel = document.getElementById('popup-actions-label');
    if (mode === 'amount') {
        actionsInput.style.display = 'none';
        amountInput.style.display = 'block';
        actionsLabel.textContent = 'Montant souhaité en FCFA';
        actionsLabel.htmlFor = 'popup-amount';
    } else {
        actionsInput.style.display = 'block';
        amountInput.style.display = 'none';
        actionsLabel.textContent = "Nombre d'actions";
        actionsLabel.htmlFor = 'popup-actions';
    }
}

document.querySelectorAll('.purchase-mode-btn').forEach((button) => {
    button.addEventListener('click', () => {
        const currentAmount = parseDecimal(document.getElementById('popup-amount').value);
        if (button.dataset.mode === 'amount' && Number.isFinite(currentAmount)) {
            document.getElementById('popup-amount').value = currentAmount.toFixed(2);
        }
        setPurchaseMode(button.dataset.mode);
        updatePurchaseSummary();
    });
});

function rateForAmount(amount) {
    const tier = currentPlan.strategie.find(item =>
        amount >= Number(item.min) && (item.max == null || amount <= Number(item.max))
    );
    if (tier) return Number(tier.rate);
    const previousTier = [...currentPlan.strategie].reverse().find(item => amount >= Number(item.min));
    return previousTier ? Number(previousTier.rate) : Number(currentPlan.strategie[0].rate);
}

function updatePurchaseSummary() {
    if (!currentPlan) return;
    const actionsInput = document.getElementById('popup-actions');
    const amountInput = document.getElementById('popup-amount');
    const rawValue = purchaseMode === 'amount' ? amountInput.value.trim() : actionsInput.value.trim();
    const balanceWarning = document.getElementById('popup-balance-warning');
    const confirmButton = document.getElementById('confirmerInvestBtn');

    if (!rawValue) {
        document.getElementById('popup-actions-help').textContent =
            purchaseMode === 'amount'
                ? 'Saisissez un montant en FCFA'
                : `Saisissez au moins ${currentPlan.actionsMinimum} actions`;
        balanceWarning.textContent = '';
        balanceWarning.style.display = 'none';
        confirmButton.disabled = true;
        return;
    }

    let actions;
    let montant;
    if (purchaseMode === 'amount') {
        montant = parseDecimal(rawValue);
        actions = Number.isFinite(montant) ? roundActions(montant / currentPlan.prixAction) : NaN;
    } else {
        actions = parseDecimal(rawValue);
        montant = Number.isFinite(actions) ? actions * currentPlan.prixAction : NaN;
    }

    if (!Number.isFinite(actions) || !Number.isFinite(montant) || actions < 1 || montant <= 0) {
        document.getElementById('popup-actions-help').textContent =
            purchaseMode === 'amount'
                ? 'Saisissez un montant FCFA valide'
                : `Saisissez un nombre d'actions valide (minimum ${currentPlan.actionsMinimum})`;
        balanceWarning.textContent = '';
        balanceWarning.style.display = 'none';
        confirmButton.disabled = true;
        return;
    }

    actionsInput.value = actions;
    if (purchaseMode === 'actions') amountInput.value = montant.toFixed(2);
    const taux = rateForAmount(montant);
    const gainJournalier = montant * taux / 100;
    const gainTotal = gainJournalier * currentPlan.duree;
    document.getElementById('popup-prix').textContent = displayMoney(montant);
    document.getElementById('popup-gain-journalier').textContent =
        displayMoney(gainJournalier);
    document.getElementById('popup-duree').textContent = currentPlan.duree + ' jours';
    document.getElementById('popup-gain-total').textContent =
        displayMoney(gainTotal);
    document.getElementById('popup-actions-help').textContent =
        `${actions} action(s) · ${displayMoney(currentPlan.prixAction)}/action · taux ${taux}%/jour · ${currentPlan.achatsRestants} achat(s) restant(s)`;

    if (actions < currentPlan.actionsMinimum) {
        balanceWarning.textContent =
            `Le minimum pour ce plan est de ${currentPlan.actionsMinimum} actions.`;
        balanceWarning.style.display = 'block';
        confirmButton.disabled = true;
    } else if (montant > soldeClient) {
        const missing = montant - soldeClient;
        balanceWarning.textContent =
            `Votre solde est de ${displayMoney(soldeClient)}. Il vous manque ${displayMoney(missing)}.`;
        balanceWarning.style.display = 'block';
        confirmButton.disabled = true;
    } else {
        balanceWarning.textContent = '';
        balanceWarning.style.display = 'none';
        confirmButton.disabled = false;
    }
}

document.getElementById('popup-actions').addEventListener('input', updatePurchaseSummary);
document.getElementById('popup-amount').addEventListener('input', updatePurchaseSummary);

function fermerPopup() { document.getElementById('investPopup').style.display = 'none'; }

function showPlanLockedMsg() {
    document.getElementById('planLockedFloater').style.display = 'flex';
}

document.getElementById('confirmerInvestBtn').addEventListener('click', function() {
    if (!currentPlan) return;
    const actions = parseFloat(document.getElementById('popup-actions').value.replace(',', '.'));
    this.disabled = true; this.textContent = 'Traitement...';
    fetch('/acheter-action', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams({ plan_id: currentPlan.id, actions })
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            fermerPopup();
            document.getElementById('success-plan-name').textContent =
                data.plan_name + ' · ' + data.nombre_actions + ' action(s)';
            document.getElementById('success-montant').textContent = displayMoney(data.montant);
            document.getElementById('success-gain').textContent =
                displayMoney(data.gain_journalier);
            document.getElementById('successPopup').style.display = 'flex';
        } else {
            showAlert(data.message || "Erreur lors de l'investissement", 'error');
            fermerPopup(); this.disabled = false; this.textContent = "Confirmer l'achat";
        }
    })
    .catch(() => { showAlert('Erreur de connexion', 'error'); fermerPopup(); this.disabled = false; this.textContent = "Confirmer l'achat"; });
});

window.addEventListener('gd-currency-change', () => {
    if (currentPlan) updatePurchaseSummary();
});

function fermerSuccessPopup() {
    document.getElementById('successPopup').style.display = 'none';
    window.location.reload();
}

function showAlert(msg, type) {
    const el = document.getElementById('alertMessage');
    el.textContent = msg;
    el.className = 'alert-msg alert-' + type;
    el.style.display = 'block';
    setTimeout(() => el.style.display = 'none', 5000);
}
</script>
</body>
</html>
